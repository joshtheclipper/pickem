# Copy this file to .env and fill in your own values before running in production.

# Port the server listens on
PORT=3000

# Secret used to sign login sessions (JWT). Set this to a long random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (optional, defaults to db/pickem.db)
# DB_PATH=/path/to/pickem.db

# Set to "true" to disable the automatic 15-minute score sync cron job
# DISABLE_CRON=false

# Web Push notifications ("a new slate has been posted"). Optional — leave
# these blank and the notification toggle in the Account page just hides
# itself. Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push also requires the app to be served over HTTPS (or localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI the push services use to reach you about delivery problems.
VAPID_SUBJECT=mailto:you@example.com
